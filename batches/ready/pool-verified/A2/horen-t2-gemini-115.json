      "audio": [
        {
          "speaker": "Felix",
          "voiceId": "de-DE-ConradNeural",
          "text": "Hallo Mia! Wie geht es dir? Hast du schon Pläne für die kommende Woche?"
        },
        {
          "speaker": "Mia",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Hallo Felix! Mir geht es gut, danke. Ja, ich habe schon einiges vor."
        },
        {
          "speaker": "Felix",
          "voiceId": "de-DE-ConradNeural",
          "text": "Erzähl mal! Was machst du am Montag?"
        },
        {
          "speaker": "Mia",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Am Montag habe ich eine wichtige Aufgabe. Ich muss für meine Prüfung lernen. Das ist meine Hauptaufgabe."
        },
        {
          "speaker": "Felix",
          "voiceId": "de-DE-ConradNeural",
          "text": "Ah, verstanden. Ich habe am Dienstag einen Deutschkurs. Ich möchte mein Deutsch verbessern."
        },
        {
          "speaker": "Mia",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Das ist eine gute Idee! Ich muss am Mittwoch zu Hause kochen. Ich möchte eine neue Suppe ausprobieren."
        },
        {
          "speaker": "Felix",
          "voiceId": "de-DE-ConradNeural",
          "text": "Lecker! Ich fahre am Donnerstag mit dem Fahrrad durch die Stadt. Ich liebe es, die Stadt so zu erkunden."
        },
        {
          "speaker": "Mia",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Das klingt toll und ist gut für die Gesundheit! Am Freitag muss ich einkaufen. Ich brauche noch ein paar Sachen für das Wochenende."
        },
        {
          "speaker": "Felix",
          "voiceId": "de-DE-ConradNeural",
          "text": "Ja, das gehört dazu. Ich muss auch noch ein paar Kleinigkeiten besorgen."
        }
      ]
    }
