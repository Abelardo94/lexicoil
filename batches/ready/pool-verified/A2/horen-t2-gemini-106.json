      "audio": [
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Hallo Katja! Wie geht es dir? Hast du schon Pläne für die Woche?"
        },
        {
          "speaker": "Katja",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Hallo Tom! Mir geht es gut, danke. Ja, ein paar Dinge stehen schon fest."
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Erzähl mal!"
        },
        {
          "speaker": "Katja",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Am Dienstag besuche ich eine neue Ausstellung im Stadtmuseum. Ich freue mich darauf."
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Oh, interessant! Ich muss am Montag zum Deutschkurs. Ich habe eine wichtige Prüfung."
        },
        {
          "speaker": "Katja",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Viel Erfolg! Was machst du am Mittwoch?"
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Am Mittwoch muss ich unbedingt einkaufen gehen. Der Kühlschrank ist fast leer."
        },
        {
          "speaker": "Katja",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Das kenne ich! Ich plane am Donnerstag eine Radtour, wenn das Wetter gut ist."
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Eine gute Idee! Und am Freitag?"
        },
        {
          "speaker": "Katja",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Am Freitag treffe ich Freunde in unserem Lieblingscafé. Wir wollen den Abend gemütlich ausklingen lassen."
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Super! Vielleicht sehen wir uns ja!"
        }
      ],
