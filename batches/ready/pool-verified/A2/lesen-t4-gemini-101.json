    {
      "id": "gen-l4-3b8de1f8-a",
      "title": "Gesund durch Bewegung",
      "text": "Unser neuer Kurs hilft Ihnen, fit zu bleiben. Wir bieten tägliche Übungen für alle Altersgruppen. Lernen Sie einfache Bewegungen für zu Hause. Keine Vorkenntnisse nötig. Starten Sie jetzt in eine gesündere Zukunft!",
      "topicTag": "Gesundheit",
      "module": "lesen",
      "teil": 4,
      "lang": "de",
      "level": "A2"
    },
    {
      "id": "gen-l4-3b8de1f8-b",
      "title": "Entspannung für den Rücken",
      "text": "Haben Sie Rückenschmerzen? In unserem Seminar lernen Sie effektive Techniken zur Entspannung und Stärkung. Ein erfahrener Physiotherapeut zeigt Ihnen, wie Sie Ihre Haltung verbessern können. Melden Sie sich bald an!",
      "topicTag": "Gesundheit",
      "module": "lesen",
      "teil": 4,
      "lang": "de",
      "level": "A2"
    },
    {
      "id": "gen-l4-3b8de1f8-c",
      "title": "Kochkurs: Leichte Küche",
      "text": "Entdecken Sie, wie einfach gesunde Ernährung sein kann! In diesem Kurs bereiten wir gemeinsam leckere und leichte Gerichte zu. Für Anfänger und Fortgeschrittene. Verbessern Sie Ihre Gesundheit mit frischen Zutaten.",
      "topicTag": "Gesundheit",
      "module": "lesen",
      "teil": 4,
      "lang": "de",
      "level": "A2"
    },
    {
      "id": "gen-l4-3b8de1f8-d",
      "title": "Erste-Hilfe-Kurs für Familien!",
      "text": "Wissen Sie, was im Notfall zu tun ist? Dieser Kurs bereitet Sie auf wichtige Situationen vor. Lernen Sie grundlegende Erste-Hilfe-Maßnahmen für Kinder und Erwachsene. Eine wichtige Aufgabe für jede Familie.",
      "topicTag": "Gesundheit",
      "module": "lesen",
      "teil": 4,
      "lang": "de",
      "level": "A2"
    },
    {
      "id": "gen-l4-3b8de1f8-e",
      "title": "Stressbewältigung Seminar",
      "text": "Fühlen Sie sich oft gestresst? Unser Seminar bietet praktische Strategien, um den Alltag besser zu meistern. Finden Sie Wege zur inneren Ruhe und verbessern Sie Ihre Lebensqualität. Melden Sie sich für mehr Wohlbefinden an.",
      "topicTag": "Gesundheit",
      "module": "lesen",
      "teil": 4,
      "lang": "de",
      "level": "A2"
    },
    {
      "id": "gen-l4-3b8de1f8-f",
      "title": "Sprechstunde im Krankenhaus",
      "text": "Das örtliche Krankenhaus bietet kostenlose Beratungen zur Herzgesundheit an. Ein Arzt beantwortet Ihre Fragen zu Vorsorge und Medikamenten. Eine gute Gelegenheit, mehr über Ihre Gesundheit zu erfahren. Keine Anmeldung nötig.",
      "topicTag": "Gesundheit",
      "module": "lesen",
      "teil": 4,
      "lang": "de",
      "level": "A2"
    }
  ],
