      "audio": [
        {
          "speaker": "Philipp",
          "voiceId": "de-DE-ConradNeural",
          "text": "Hallo Sara! Wie geht es dir? Hast du schon Pläne für die Woche?"
        },
        {
          "speaker": "Sara",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Hallo Philipp! Mir geht es gut, danke. Ja, ich habe schon einiges vor."
        },
        {
          "speaker": "Philipp",
          "voiceId": "de-DE-ConradNeural",
          "text": "Erzähl mal! Ich muss am Montag zuerst einkaufen gehen, der Kühlschrank ist leer."
        },
        {
          "speaker": "Sara",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Ah, das kenne ich! Ich werde am Dienstagabend etwas Neues kochen. Vielleicht ein Rezept aus einem Online-Blog."
        },
        {
          "speaker": "Philipp",
          "voiceId": "de-DE-ConradNeural",
          "text": "Klingt lecker! Ich fahre am Mittwoch mit dem Fahrrad zur Arbeit, wenn das Wetter gut ist. Das ist mein täglicher Sport."
        },
        {
          "speaker": "Sara",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Super! Ich habe am Donnerstag einen Deutschkurs. Das ist wichtig für meine Zukunft hier."
        },
        {
          "speaker": "Philipp",
          "voiceId": "de-DE-ConradNeural",
          "text": "Ja, Deutsch lernen ist eine gute Aufgabe. Und am Freitag? Ich besuche ein Museum, es gibt eine interessante Ausstellung über alte Medien."
        },
        {
          "speaker": "Sara",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Oh, das ist ja passend zum Thema! Ich habe am Freitag nichts Besonderes."
        }
      ]
    }
