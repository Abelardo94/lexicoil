        {
          "speaker": "David",
          "voiceId": "de-DE-ConradNeural",
          "text": "Oh, schön! Am Dienstag treffe ich Freunde in einem Café. Wir reden ein Bisschen."
        },
        {
          "speaker": "Julia",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Das klingt gemütlich! Ich muss am Mittwoch Sport machen. Ich gehe ins Fitnessstudio. Das ist wichtig für meine Fitness."
        },
        {
          "speaker": "David",
          "voiceId": "de-DE-ConradNeural",
          "text": "Ja, Sport ist gesund! Ich habe am Donnerstag meinen Deutschkurs. Das ist immer sehr lehrreich."
        },
        {
          "speaker": "Julia",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Gut! Und am Freitagabend? Ich gehe ins Kino. Kommst du mit?"
        },
        {
          "speaker": "David",
          "voiceId": "de-DE-ConradNeural",
          "text": "Kino am Freitag? Vielleicht! Ich sage dir noch Bescheid."
        }
